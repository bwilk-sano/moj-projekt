<%= link_to note, class: "note-card #{accent_for(note)}", id: dom_id(note), data: { filter_target: "item" } do %>
  <h3 class="note-card__title"><%= note.title.presence || "Bez tytułu" %></h3>
  <p class="note-card__body"><%= truncate(note.body.to_s, length: 220) %></p>
  <span class="meta"><%= icon :clock, size: 13 %> <%= time_ago_in_words(note.updated_at) %> temu</span>
<% end %>
