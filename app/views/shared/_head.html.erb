<title><%= [ content_for(:title), "Moj Projekt" ].compact.join(" · ") %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="Moj Projekt">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0a0913" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f5f4fb" media="(prefers-color-scheme: light)">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%# Apply the saved theme before first paint, so there is no light/dark flash %>
<script>
  try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t } catch (_) {}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap">

<%= yield :head %>

<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.png">

<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
